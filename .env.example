# Copy to .env and fill in. Every value here is read through settings.env(),
# which treats an EMPTY value as absent and falls back to the default.
#
# That is not a stylistic choice. homeschool-lms shipped SERVER_EMAIL and
# LOG_DIR present-but-empty in its .env, so `os.environ.get(name, default)`
# returned '' rather than the default, and every deployment that followed the
# example file sent error mail from nobody and wrote logs to whatever
# directory the process happened to start in. Nothing announced it. Leaving a
# key blank here is therefore safe, and means "use the default".

# Required in production. Leave blank in development and a throwaway key is
# invented for you.
DJANGO_SECRET_KEY=

# 'True' or 'False'. Anything else is False.
DJANGO_DEBUG=True

# Comma-separated, and REQUIRED when DJANGO_DEBUG is False. Leave it blank in
# development: blank means absent, and absent with DEBUG on defaults to
# localhost and 127.0.0.1, which is what runserver needs. Filling in the real
# hosts here would make the development server refuse its own requests.
#
# In production:  DJANGO_ALLOWED_HOSTS=milepostfamily.com,www.milepostfamily.com
DJANGO_ALLOWED_HOSTS=

# Where to write logs. Defaults to ./logs next to manage.py.
LOG_DIR=

# Postgres. Unset means SQLite, which is the development default and must
# never be the production one.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
